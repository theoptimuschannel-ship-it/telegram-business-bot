# Токен от @BotFather
BOT_TOKEN=123456:ABC-your-token
# Ваш числовой Telegram ID (узнать можно у @userinfobot)
OWNER_ID=123456789

# Через сколько дней удалять сохранённые сообщения
RETENTION_DAYS=30
# Часовой пояс для дат в уведомлениях
TIMEZONE=UTC
# Пауза между кадрами анимации, секунды (минимум 0.6)
ANIM_DELAY=0.8

# Пути (в Docker переопределяются)
DB_PATH=data/bot.db
LOG_FILE=data/logs/bot.log
